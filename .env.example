# ─────────────────────────────────────────────────────────────────────
#  Sonogami Solver — environment reference
# ─────────────────────────────────────────────────────────────────────
#  Copy to .env and edit.  .env is gitignored; this file is not.
#
#      cp .env.example .env
#
#  IMPORTANT: the service does NOT read .env by itself. There is no dotenv
#  loader in this codebase, deliberately — an env file that silently overrides
#  the unit environment is a debugging trap. Pick one of these:
#
#    systemd (recommended for the deployment in the README):
#        # in the [Service] section of the unit
#        EnvironmentFile=/opt/captcha-solver/.env
#        systemctl daemon-reload && systemctl restart captcha-solver
#
#    shell (for local runs):
#        set -a; . ./.env; set +a; ./run.sh
#
#  Anything left commented out keeps the default shown.
# ─────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════
#  ADMIN DASHBOARD  (optional — leave unset and the dashboard 404s)
# ═════════════════════════════════════════════════════════════════════
#  Without SOLVER_ADMIN_USER plus a password, every dashboard route returns
#  404 and the solver behaves exactly as it did before the dashboard existed.
#  This is the single-operator console; there is no signup and no user table.

SOLVER_ADMIN_USER=admin

# Preferred: the scrypt digest, so the plaintext is nowhere on the box.
# Generate with:
#     python -m web.auth generate     # prints a strong random password
#     python -m web.auth hash         # prompts, prints the digest
ADMIN_PASSWORD_HASH=

# Alternative, first-boot only: the service hashes this once and persists the
# digest to SOLVER_ADMIN_HASH_FILE, then you should delete this line. Minimum
# 12 characters; shorter values are rejected with a warning and the dashboard
# stays closed. Prefer ADMIN_PASSWORD_HASH — this value is visible to anyone
# who can run `systemctl show captcha-solver`.
# ADMIN_PASSWORD=

# Signing key for session CSRF tokens. Generate with: openssl rand -hex 32
# Set this, or every restart invalidates all sessions. Rotating it is the
# equivalent of "log out everywhere".
SOLVER_CSRF_SECRET=

# Session lifetime in seconds (default 12h) and the cookie's Max-Age.
# SOLVER_SESSION_TTL=43200

# Where the admin digest and the live session table live. Relative paths
# resolve against the service WorkingDirectory (the checkout), so they are
# covered by .gitignore. Point them somewhere outside the repo if you prefer.
# SOLVER_ADMIN_HASH_FILE=.solver-admin.json
# SOLVER_SESSION_FILE=.solver-sessions.json

# Login throttling, per client IP. A correct password during lockout is still
# refused — guessing right on attempt N+1 does not clear the lockout.
# SOLVER_LOGIN_MAX_FAILURES=5
# SOLVER_LOGIN_LOCKOUT_S=300

# Force the session cookie's Secure flag. Default: inferred per request (on
# when the request arrived over https, off for plain-http loopback dev). Set
# to 1 to pin it on regardless of how the request arrived.
# SOLVER_COOKIE_SECURE=


# ═════════════════════════════════════════════════════════════════════
#  API BEARER TOKEN  (required unless you opt out explicitly)
# ═════════════════════════════════════════════════════════════════════
#  Gates /solve, /health, /status and /logs. /health is included on purpose:
#  a public liveness probe tells an anonymous scanner the service exists.
#
#  With NO token configured the service FAILS CLOSED — those endpoints refuse
#  every caller. That is deliberate: the shipped unit binds a port, so a
#  silent skip would leave the solver open whenever the reverse proxy is not
#  the only way in.
#
#  Preferred: the sha256 of the token, so the secret itself never appears in
#  the unit environment or in `systemctl show`.
#      printf %s "$TOKEN" | sha256sum
SOLVER_API_TOKEN_SHA256=

# Alternative: the raw token. Hashed in-process at startup.
# SOLVER_API_TOKEN=

# Escape hatch for a single-host dev box where the reverse proxy IS the only
# access path and you want token-free local calls. Never set this on a host
# that anything else can reach.
# SOLVER_ALLOW_UNAUTHENTICATED=1


# ═════════════════════════════════════════════════════════════════════
#  TWO-SUBDOMAIN ISOLATION  (recommended; off when both are unset)
# ═════════════════════════════════════════════════════════════════════
#  Splitting the surfaces is a security boundary, not routing preference:
#  each origin then holds exactly one credential type, so neither can be
#  leveraged into the other.
#
#      dash.example.com  ->  session cookie + CSRF header
#      api.example.com   ->  static Bearer token, no cookies, no login route
#
#  Setting EITHER value turns enforcement on: unknown Host headers get 421,
#  and each host refuses the other surface's paths with 404. Because that
#  makes a bare 127.0.0.1 request a 421, they are left commented so a straight
#  copy of this file still boots a working single-host service.
#  Uncomment BOTH once your DNS and Caddy vhosts exist.

# SOLVER_DASHBOARD_HOST=dash.example.com
# SOLVER_API_HOST=api.example.com

# Extra hostnames allowed to reach everything (a LAN address for on-box
# debugging, say). Comma-separated. Ignored unless one of the two above is set.
# SOLVER_ALLOWED_HOSTS=127.0.0.1,localhost

# Trust proxy headers when identifying the client for the login throttle.
# Only set this when a proxy you control always sets them.
#
# When enabled the key is CF-Connecting-IP if present, else the LAST entry of
# X-Forwarded-For — the hop your proxy appended. The FIRST entry is
# attacker-controlled (Caddy preserves a client-supplied prefix), so using it
# would let anyone rotate the lockout key at will.
#
# With this unset, every caller shares one bucket. For a single-operator tool
# that is the stricter behaviour, so leave it off unless you need per-IP
# lockouts.
# SOLVER_TRUST_PROXY=1


# ═════════════════════════════════════════════════════════════════════
#  NETWORK
# ═════════════════════════════════════════════════════════════════════
# Listen address. Default 127.0.0.1: the documented topology terminates TLS at
# a local proxy (Cloudflare tunnel -> Caddy -> this process), so the service
# does not need to be reachable directly. Set 0.0.0.0 only if you really do
# want direct access — and then keep the Bearer token configured.
SOLVER_BIND_HOST=127.0.0.1
PORT=8877

# Public base URL shown in the OpenAPI schema (contact + servers dropdown).
# Cosmetic; it does not change routing.
# SOLVER_PUBLIC_URL=https://api.example.com

# Public API base URL displayed on the landing page and the /docs page, and
# used in their curl examples. Also cosmetic. If unset, the pages fall back to
# https://api.example.com, so a local run shows a URL that does not resolve —
# harmless, but set it if you are demoing.
# SOLVER_API_PUBLIC_URL=https://api.example.com

# Allow the solver to navigate to private / loopback / link-local targets.
# OFF by default: caller-supplied URLs (url, verify_url, page_url,
# post_fetch[].url) are SSRF-guarded. Turn on only for local testing against
# a target on your own network.
# SOLVER_ALLOW_PRIVATE=1


# ═════════════════════════════════════════════════════════════════════
#  BROWSER  (the solvers drive a real anti-detect Chromium)
# ═════════════════════════════════════════════════════════════════════
# Headless is global across every solver. 0 = headed, which is what this
# deployment runs: several providers detect headless. Headed requires an X
# display, so keep DISPLAY and XAUTHORITY pointing at the persistent Xvfb
# started by start-xvfb.sh (do NOT use xvfb-run -a — its random auth path is
# not reliably inherited down the subprocess chain).
BROWSER_HEADLESS=0
DISPLAY=:99
XAUTHORITY=/opt/captcha-solver/.cache/Xauthority

# CRITICAL. Pin the browser binary this deployment was validated against.
# Without this the wrapper resolves the newest Pro build from cloakbrowser.dev
# and downloads it over the local one, so every launch runs a build whose
# behaviour may differ from the one you validated — including any local
# patching applied to that build. This variable is checked before any download
# logic, which matters because a free-plan key cannot pin a version at all: the
# wrapper drops explicit version pins for that plan and the download endpoint
# force-serves the latest build.
CLOAKBROWSER_BINARY_PATH=/opt/captcha-solver/browser/chrome

# Solve concurrency cap. Each solve holds roughly 1 GB, so this bounds memory.
# Unset = auto (derived from CPU/memory). 0 = uncapped, which logs a warning.
# Set to a small number like 2 on a constrained box.
# SOLVER_MAX_CONCURRENT=


# ═════════════════════════════════════════════════════════════════════
#  VISION MODELS  (reCAPTCHA / hCaptcha image challenges)
# ═════════════════════════════════════════════════════════════════════
# The Mistral key pool is read from common/apikey.txt, one key per line.
# That file is NOT in the repo (gitignored, chmod 600) — create it on the
# deployment host. There is no env var for the keys themselves.
#     printf '%s\n' "$KEY1" "$KEY2" > common/apikey.txt && chmod 600 common/apikey.txt
#
# Model used for the image classifier. Defaults are fine unless you are
# chasing a specific capability or cost profile.
# RECAPTCHA_MISTRAL_MODEL=mistral-medium-latest
# HCAPTCHA_MISTRAL_MODEL=mistral-medium-latest


# ═════════════════════════════════════════════════════════════════════
#  ALIYUN CAPTCHA 2.0
# ═════════════════════════════════════════════════════════════════════
# The solver ships with working public credentials as built-in fallbacks, so
# this usually needs nothing. Override only if you have your own AccessKey
# for the captcha-open endpoint.
# ALIYUN_CAPTCHA_AK_ID=
# ALIYUN_CAPTCHA_AK_SECRET=


# ═════════════════════════════════════════════════════════════════════
#  FRONTEND BUILD  (read at build time, not runtime)
# ═════════════════════════════════════════════════════════════════════
# Vite inlines these into the bundle, so they must be set BEFORE
# `npm --prefix web/ui run build`, and they are public by definition —
# never put a secret here.
#
# Source link in the header and footer. Defaults to the upstream repo.
# VITE_REPO_URL=https://github.com/waguriagentic/captcha-solver


# ═════════════════════════════════════════════════════════════════════
#  TESTING
# ═════════════════════════════════════════════════════════════════════
# Port used by tools/smoke_dashboard.py for its scratch server. It sets its
# own credentials and host names, so nothing above is needed to run it:
#     python tools/smoke_dashboard.py
# SMOKE_PORT=8899
